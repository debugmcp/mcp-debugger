# Disable set -e inherited from husky's sh -e wrapper.
# Git hooks run with stdout as a closed/broken pipe, causing echo to fail
# with "write error: Bad file descriptor". Under set -e this silently kills
# the entire hook. This script has explicit exit 1 calls for real failures.
set +e

# Redirect stdout to stderr so user-facing messages reach the terminal
# instead of git's closed stdout pipe.
exec 1>&2

echo "🔎 Running pre-push checks to ensure code quality..."
echo "💡 Branch pushes run static checks; tags-only pushes also build and test."
echo ""

# Source cargo environment for Rust tools and cargo-installed Docstar on either path.
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

# Detect if this push contains only tags (read refs from stdin)
TMP_REFS=$(mktemp 2>/dev/null || echo ./.prepush_tmp)
cat - > "$TMP_REFS"
TAGS_ONLY=true
if [ ! -s "$TMP_REFS" ]; then
    # If no stdin provided, assume this is not a tags-only push
    TAGS_ONLY=false
else
    while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
        case "$LOCAL_REF" in
            refs/tags/*) : ;; # tag, ok
            *) TAGS_ONLY=false ;;
        esac
    done < "$TMP_REFS"
fi
rm -f "$TMP_REFS" 2>/dev/null || true

# Tags-only pushes probe Docker before running the build and unit suite.
if [ "$TAGS_ONLY" = true ]; then
    # Auto-detect Docker availability and skip Docker tests if not fully functional
    if ! docker buildx version >/dev/null 2>&1; then
        export SKIP_DOCKER_TESTS=true
        echo "Docker buildx not available - Docker tests will be skipped."
        echo ""
    fi
fi

# Log file for verbose output (keeps hook stdout small to avoid SIGPIPE)
PRE_PUSH_LOG=$(mktemp 2>/dev/null || echo ./.pre-push-log)
cleanup_log() { rm -f "$PRE_PUSH_LOG" 2>/dev/null || true; }
trap cleanup_log EXIT

# Run linting first to catch syntax and style issues
echo "🔎 Running ESLint to catch linting issues..."
if ! pnpm run lint > "$PRE_PUSH_LOG" 2>&1; then
    echo ""
    echo "❌ Lint failed! Push blocked to prevent broken code on GitHub."
    echo "💡 Run 'pnpm run lint' to see all errors, or 'pnpm run lint:fix' for auto-fixes."
    echo ""
    tail -20 "$PRE_PUSH_LOG"
    exit 1
fi

echo "✅ Lint passed!"
echo ""

# Type-only checks (no build needed). CI builds and runs the suites for branch PRs;
# the ratchet also blocks new type errors in tests (issue #562).

# The ratchet validates the working tree against the working-tree baseline, but CI
# validates the pushed commit. An uncommitted baseline therefore passes here and fails
# there — which is exactly the state the hook's own remediation hint leaves you in.
if ! git diff --quiet HEAD -- tests/typecheck-baseline.json; then
    echo ""
    echo "❌ tests/typecheck-baseline.json is modified but not committed."
    echo "💡 Commit it: the ratchet check that runs in CI reads the pushed commit, not your working tree."
    echo ""
    exit 1
fi

echo "🧮 Running typecheck (sources + test ratchet)..."
if ! pnpm run typecheck:all > "$PRE_PUSH_LOG" 2>&1; then
    echo ""
    echo "❌ Typecheck failed! Push blocked to prevent broken code on GitHub."
    echo "💡 Reproduce with 'pnpm run typecheck:all'."
    echo "💡 If a test's error count changed on purpose, run 'pnpm run typecheck:tests:update' and commit the baseline."
    echo ""
    # The ratchet reports summary-first, so a plain tail shows only the last file's
    # diagnostics. Print its header and every per-file "before -> after" line instead.
    grep -E "gained type errors|FEWER errors than|-> [0-9]+|error TS[0-9]+:" "$PRE_PUSH_LOG" | head -40 || true
    echo ""
    echo "Full log: $PRE_PUSH_LOG"
    # Keep log on failure so user can inspect
    trap - EXIT
    exit 1
fi

echo "✅ Typecheck passed!"
echo ""

if [ "$TAGS_ONLY" != true ]; then
    echo "📚 Checking documentation consistency..."
    if ! pnpm run check:docs > "$PRE_PUSH_LOG" 2>&1; then
        echo ""
        echo "❌ Documentation check failed! Push blocked to prevent broken docs on GitHub."
        echo "💡 Run 'pnpm run check:docs' and fix the reported links or counts."
        echo ""
        tail -20 "$PRE_PUSH_LOG"
        exit 1
    fi
    echo "✅ Documentation check passed!"
    echo ""

    echo "📝 Validating changelog fragments..."
    if ! pnpm run changelog:check > "$PRE_PUSH_LOG" 2>&1; then
        echo ""
        echo "❌ Changelog check failed! Push blocked to prevent invalid fragments on GitHub."
        echo "💡 Run 'pnpm run changelog:check' and follow 'changelog.d/README.md'."
        echo ""
        tail -20 "$PRE_PUSH_LOG"
        exit 1
    fi
    echo "✅ Changelog check passed!"
    echo ""

    # Audit supported text files in the working tree, tracked or unignored untracked.
    # An untracked scratch file can block a push; delete it or ignore it.
    echo "🔒 Checking all files for personal information..."
    if ! pnpm run check:all-personal-paths > "$PRE_PUSH_LOG" 2>&1; then
        echo ""
        echo "❌ Personal information check failed! Push blocked to protect your privacy."
        echo "💡 Run 'pnpm run check:all-personal-paths' and replace personal paths with generic examples."
        echo ""
        tail -20 "$PRE_PUSH_LOG"
        exit 1
    fi
    echo "✅ Personal information check passed!"
    echo ""
    echo "✅ All static checks passed! Push will proceed."
    echo "🚀 CI builds and runs the suites once this branch has a pull request to main."
else
    # Clean build to ensure no stale artifacts
    echo "🔨 Running clean build to ensure fresh compilation..."
    if ! (npm run clean > "$PRE_PUSH_LOG" 2>&1 && npm run build >> "$PRE_PUSH_LOG" 2>&1); then
        echo ""
        echo "❌ Build failed! Push blocked to prevent broken code on GitHub."
        echo "💡 Fix build errors before pushing."
        echo ""
        tail -20 "$PRE_PUSH_LOG"
        exit 1
    fi

    echo "✅ Build successful!"
    echo ""

    # Tag-only pushes run a clean build and the reduced release-CI suite.
    # A tag push is a release step, so this path stays separate.
    echo "🔖 Tag-only push detected. Running reduced CI tests..."
    npm run test:ci-no-python > "$PRE_PUSH_LOG" 2>&1

    TEST_EXIT=$?

    # Show the test summary (last few lines contain pass/fail counts)
    grep -E "Test Files|Tests |Duration" "$PRE_PUSH_LOG" || true

    if [ $TEST_EXIT -eq 0 ]; then
        echo ""
        echo "✅ All tests passed! Push will proceed."
        echo "🚀 Code quality maintained for GitHub repository."
    else
        echo ""
        echo "❌ Tests failed! Push blocked to prevent broken code on GitHub."
        echo "💡 Fix failing tests or use 'git push --no-verify' for emergency pushes."
        echo "🔧 You can still make local commits for WIP - this hook runs tests only on tags-only pushes."
        echo ""
        echo "Failed test details:"
        grep -E "FAIL|Error|AssertionError" "$PRE_PUSH_LOG" | head -20 || true
        echo ""
        echo "Full log: $PRE_PUSH_LOG"
        # Keep log on failure so user can inspect
        trap - EXIT
        exit 1
    fi
fi

# Docstar full shadow + check (optional — runs only if docstar is installed)
if command -v docstar >/dev/null 2>&1; then
  echo "📝 Docstar: Updating shadow documentation..."
  docstar shadow . 2>/dev/null || true
  echo "🔍 Docstar: Checking documentation..."
  docstar check || true
fi
