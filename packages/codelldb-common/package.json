{
  "name": "@debugmcp/codelldb-common",
  "version": "0.22.0",
  "description": "Shared CodeLLDB vendoring, resolution, and spawn glue for CodeLLDB-backed MCP Debugger adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ci": "tsc -p tsconfig.json",
    "build:adapter": "node scripts/vendor-codelldb.js",
    "clean": "rimraf dist vendor",
    "clean:vendor": "rimraf vendor",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "extract-zip": "^2.0.1",
    "progress": "^2.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Sycamore LLC <debug@sycamore.llc> (https://github.com/debugmcp)"
}
