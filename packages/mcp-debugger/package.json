{
  "name": "@debugmcp/mcp-debugger",
  "version": "0.24.2",
  "description": "Step-through debugging MCP server for LLMs",
  "homepage": "https://github.com/debugmcp/mcp-debugger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debugmcp/mcp-debugger.git",
    "directory": "packages/mcp-debugger"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-debugger": "./dist/cli"
  },
  "files": [
    "dist",
    "skills",
    "pi.mcp.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "mcp": [
      "./pi.mcp.json"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/bundle-cli.js",
    "build:ci": "node scripts/bundle-cli.js",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@debugmcp/codelldb-darwin-arm64": "1.11.8",
    "@debugmcp/codelldb-darwin-x64": "1.11.8",
    "@debugmcp/codelldb-linux-arm64": "1.11.8",
    "@debugmcp/codelldb-linux-x64": "1.11.8",
    "@debugmcp/codelldb-win32-x64": "1.11.8"
  },
  "devDependencies": {
    "@debugmcp/adapter-cobol": "0.24.2",
    "@debugmcp/adapter-cpp": "0.24.2",
    "@debugmcp/adapter-dotnet": "0.24.2",
    "@debugmcp/adapter-go": "0.24.2",
    "@debugmcp/adapter-java": "0.24.2",
    "@debugmcp/adapter-javascript": "0.24.2",
    "@debugmcp/adapter-python": "0.24.2",
    "@debugmcp/adapter-mock": "0.24.2",
    "@debugmcp/adapter-ruby": "0.24.2",
    "@debugmcp/adapter-rust": "0.24.2",
    "@debugmcp/shared": "0.24.2"
  },
  "author": "Sycamore LLC <admin@debugmcp.io> (https://github.com/debugmcp)"
}
