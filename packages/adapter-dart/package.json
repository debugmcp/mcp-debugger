{
  "name": "@debugmcp/adapter-dart",
  "version": "0.25.1",
  "description": "Dart and Flutter debug adapter for MCP Debugger using the SDK's own DAP servers (dart debug_adapter / flutter debug-adapter)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-bridge.mjs",
    "build:ci": "tsc -p tsconfig.json && node scripts/bundle-bridge.mjs",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debugmcp/mcp-debugger.git",
    "directory": "packages/adapter-dart"
  },
  "keywords": [
    "mcp",
    "debugger",
    "dart",
    "flutter",
    "debug-adapter-protocol"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@debugmcp/shared": "0.25.1"
  },
  "dependencies": {
    "@debugmcp/shared": "workspace:*",
    "@vscode/debugprotocol": "^1.68.0",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/which": "^3.0.4",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Sycamore LLC <admin@debugmcp.io> (https://github.com/debugmcp)"
}
