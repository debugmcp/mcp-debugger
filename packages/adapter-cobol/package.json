{
  "name": "@debugmcp/adapter-cobol",
  "version": "0.24.2",
  "private": true,
  "description": "COBOL debug adapter for MCP Debugger using GnuCOBOL and CodeLLDB",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-shim.mjs",
    "build:ci": "tsc -p tsconfig.json && node scripts/bundle-shim.mjs",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@debugmcp/codelldb-common": "workspace:*",
    "@debugmcp/shared": "workspace:*",
    "@vscode/debugprotocol": "^1.68.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Sycamore LLC <admin@debugmcp.io> (https://github.com/debugmcp)"
}
